{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Omarchy owns ~/.bashrc, so only add the lines that load the shared env and aliases.
[ -f "$HOME/.bashrc" ] || exit 0
for f in env aliases; do
  line="[ -f \"\$HOME/.config/shell/$f.sh\" ] && source \"\$HOME/.config/shell/$f.sh\""
  grep -qxF "$line" "$HOME/.bashrc" || printf '\n%s\n' "$line" >> "$HOME/.bashrc"
done
exit 0
{{ end -}}
