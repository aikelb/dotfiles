{
  "$schema": "https://opencode.ai/config.json",

  // ── Models ────────────────────────────────────────────────────────────────
  // Default for my own sessions: GPT-6 Luna on ChatGPT Go (`/connect` → OpenAI,
  // ChatGPT login). Not zero-retention; model training is off in ChatGPT's Data
  // Controls. For anything private pick a commandcode/ model with /models.
  //
  // Command Code GOAT (Provider API, every request with ZDR). Key: `/connect` →
  // Other → provider id `commandcode` (stored in ~/.local/share/opencode/auth.json).
  // Ranking (19 Nov 2026: benchmarks + opencode.ai/data retention + price per
  // cached token on Command Code; full table in ops/pins/herdr-guide.html):
  //   1 default     deepseek/deepseek-v4.1-flash  best value; double price weekdays 01–04/06–10 UTC
  //   2 cheap       xiaomi/mimo-v2.6-flash → minimax/minimax-m3.1-flash → z-ai/glm-5.3-flash
  //                 → tencent/hy4-flash → MiniMaxAI/MiniMax-M3
  //   3 stronger    xiaomi/mimo-v2.6-pro, tencent/hy4-preview, deepseek/deepseek-v4-pro
  //   4 hard tasks  moonshotai/Kimi-K3.1-Pro (short sessions: re-reading context is pricey)
  //   manual only   zai-org/GLM-5.3 and the rest (expensive cached tokens)
  // ZDR checked 17 Nov 2026, except the ones marked "ZDR pending": check them with
  // `task zdr -- <model-id>` in ~/git/ops when the plan is back (24 Nov 2026).
  // Window hit: the 5-hour/weekly windows are plan-wide, switching model doesn't help.
  // Switch model: /models in the session (opencode v2.3 has no -m flag).
  "model": "openai/gpt-6-luna",

  // Titles stay on the Mac: local model served by `ia` (llama.cpp) on port 8080.
  // Start it first in another terminal: ia ornith
  "small_model": "local/ornith",

  // ── Providers we never use ────────────────────────────────────────────────
  // deepseek: old pay-as-you-go API, replaced by Command Code.
  // opencode: Zen pay-as-you-go and its free models (some may train on requests).
  "policies": [
    { "action": "provider.use", "resource": "deepseek", "effect": "deny" },
    { "action": "provider.use", "resource": "opencode", "effect": "deny" }
  ],

  "provider": {
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        // Zero data retention on every request: only ZDR upstreams are used and
        // a model without one fails with 422 cmd_zdr_no_providers (no fallback).
        "headers": { "x-cmd-zdr": "1" }
      },
      // `limit` is a cost budget, not the models' real window (GLM-5.3 takes ~1M):
      // OpenCode compacts the conversation before it reaches it. Without it, a long
      // session re-sent 200-400K tokens per step and spent the weekly window in a day.
      // Full catalog: GET https://api.commandcode.ai/provider/v1/models
      // Left out: Claude models (Messages API only; Claude Code covers them).
      // Free models can't run under ZDR: they live in `commandcode-free` below.
      "models": {
        "deepseek/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash", "limit": { "context": 131072, "output": 32768 } },
        "xiaomi/mimo-v2.6-flash": { "name": "MiMo V2.6 Flash (ZDR pending)", "limit": { "context": 131072, "output": 32768 } },
        "minimax/minimax-m3.1-flash": { "name": "MiniMax M3.1 Flash (ZDR pending)", "limit": { "context": 131072, "output": 32768 } },
        "tencent/hy4-flash": { "name": "Hy4 Flash (ZDR pending)", "limit": { "context": 131072, "output": 32768 } },
        "tencent/hy4-preview": { "name": "Hy4 Preview (ZDR pending)", "limit": { "context": 131072, "output": 32768 } },
        "zai-org/GLM-5.3": { "name": "GLM-5.3", "limit": { "context": 131072, "output": 32768 } },
        "moonshotai/Kimi-K3.1-Pro": { "name": "Kimi K3.1 Pro", "limit": { "context": 131072, "output": 32768 } },
        "moonshotai/Kimi-K2.7-Code": { "name": "Kimi K2.7 Code", "limit": { "context": 131072, "output": 32768 } },
        "deepseek/deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "limit": { "context": 131072, "output": 32768 } },
        "z-ai/glm-5.3-flash": { "name": "GLM-5.3 Flash", "limit": { "context": 131072, "output": 32768 } },
        "inclusionai/ling-3.1-flash": { "name": "Ling 3.1 Flash", "limit": { "context": 131072, "output": 32768 } },
        "MiniMaxAI/MiniMax-M3": { "name": "MiniMax M3", "limit": { "context": 131072, "output": 32768 } },
        "Qwen/Qwen4-Max": { "name": "Qwen4 Max", "limit": { "context": 131072, "output": 32768 } },
        "xiaomi/mimo-v2.6-pro": { "name": "MiMo V2.6 Pro", "limit": { "context": 131072, "output": 32768 } },
        "ornith/ornith-1.5-122b": { "name": "Ornith 1.5 122B", "limit": { "context": 131072, "output": 32768 } }
      }
    },
    // Command Code free models, picked by hand only (/models). NO zero data
    // retention: they may run under different provider terms (retained, used for
    // training), so only for non-sensitive content. Daily quotas, $0, don't use the
    // per-model allowances; Command Code needs $1 of balance on the account.
    // Key: `/connect` → Other → provider id `commandcode-free` → the same key.
    "commandcode-free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code FREE (no ZDR)",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1"
      },
      "models": {
        "stealth/glyph-cluster:free": { "name": "Glyph Cluster (free, no ZDR)", "limit": { "context": 131072, "output": 32768 } },
        "recursive/flint-v1.0:free": { "name": "Flint (free, no ZDR)", "limit": { "context": 131072, "output": 32768 } },
        "thinkingmachines/inkling-2-small:free": { "name": "Inkling 2 Small (free, no ZDR)", "limit": { "context": 1000000, "output": 32768 } }
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local (ia)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        // llama-server serves whatever model is loaded; the name is just for OpenCode
        "ornith": {
          "name": "Ornith-1.5 9B (local)",
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  }
}
