#!/usr/bin/env bash
# ia — lanzador de modelos locales
# Un solo modelo de texto cargado cada vez, siempre en http://localhost:8080/v1 y con el nombre
# «local» (--alias local), sea cual sea. OpenCode usa «local/local» y habla con el que esté en marcha.
#
# Uso:
#   ia              → menú (marca qué modelos están instalados)
#   ia ornith       → Ornith-1.5 9B: código, agentes, imágenes y documentos (64K)
#                     Por defecto con MTP, visión y como mucho 2048 tokens pensando
#                     (ganó en ia-bench el 9 nov 2026: código 7/7, documentos 100, ~15-20 tok/s)
#   ia mellum       → Mellum2.1 12B (en pruebas): MoE con 2,5B activos, muy rápido; código y
#                     agentes, sin visión. Por defecto con MTP (ia mellum base → sin MTP).
#   ia inkling      → Inkling 2 Mini (en pruebas): MoE de 26B con 3,4B activos en Q2 (9,1 GB),
#                     el mejor en las cifras de código; va justo de memoria. Sin visión por
#                     defecto (IA_VISION=1 la activa, +0,6 GB). ia inkling dspark → con borrador.
#   ia ocr          → Xiaomi-OCR-0: pasar documentos a texto/Markdown, muy rápido
#   ia embla        → Embla 1 (en pruebas): MoE de 10B con 1B activo, muy rápido; solo chat (256K)
#                     (su motor no admite herramientas ni imágenes). La primera vez clona y
#                     compila embla-metal en ~/models/embla-metal (necesita Xcode o las
#                     Command Line Tools) y descarga el modelo (5,6 GB).
#   ia voice        → Chatterbox (MIT): voz (texto a voz) clonando ~/models/voices/ibai.wav.
#                     Va en otro puerto (8090), así que puede convivir con un modelo de texto.
#                     (alias: ia voz) · ia voice stop → parar solo la voz
#   ia say "texto"  → leer un texto en voz alta (también: pbpaste | ia say). Arranca la voz
#                     en segundo plano si no está en marcha.
#   ia say -v jeni "texto" → con otra voz de referencia: un nombre de ~/models/voices/<nombre>.wav
#                     o la ruta de un .wav/.mp3. ia voice list → voces disponibles.
#   ia tags         → qué modelo usar para cada cosa (etiquetas)
#   ia tags code    → solo los modelos con esa etiqueta
#                     (code · agent · chat · vision · docs · ocr · voice)
#   ia list         → ver qué está instalado y cuánto ocupa
#   ia rm <modelo>  → borrar un modelo o borrador, pide confirmación
#                     (ornith|mellum|inkling|ocr|voice, y los descartados: bonsai|mimo|mimo-mtp|
#                     qwopus|ornith-dflash|dflash-qwen|lfm3-audio|qwen3-tts)
#   ia stop         → parar todo lo que esté corriendo (también la voz)
#
# Decodificación especulativa de Ornith, como segundo argumento:
#   ia ornith         → MTP (su propia cabeza, no descarga nada más). Es lo normal.
#   ia ornith base    → sin decodificación especulativa
#   ia ornith dflash  → borrador DFlash oficial (~0,8 GB; fue algo más lento que MTP)
#   ia ornith ngram   → ngram-mod (no ayudó en las pruebas)
#   Necesita un llama.cpp reciente (llama update).
#
# Variables opcionales:
#   IA_CTX=32768 ia ocr    → cambiar el contexto
#   IA_PORT=8081 ia ocr    → cambiar el puerto (por defecto 8080)
#   IA_KV=q4_0 ia ornith   → caché KV más pequeña si va justo de memoria (por defecto q8_0)
#   IA_NOVISION=1 ia ornith → sin la parte de imágenes (ahorra ~0,9 GB de memoria)
#   IA_SPEC=dflash ia ornith → lo mismo que el segundo argumento
#   IA_SPEC_N=3            → tokens que propone el borrador (mtp: 2, dflash/dspark: 8 por defecto)
#   IA_THINK=4096 ia ornith → límite de tokens pensando (Ornith: 2048 por defecto; -1 = sin límite)
#   IA_SERVER=/ruta ia …   → usar otro llama-server en vez de «llama serve»
#   IA_YES=1 ia …          → no preguntar nada (lo usa ia-bench)
#   IA_VOICE_PORT=8091     → puerto de la voz (por defecto 8090)
#   IA_VOICE_REF=~/x.wav   → voz de referencia para clonar (por defecto ~/models/voices/ibai.wav)

set -euo pipefail

PORT="${IA_PORT:-8080}"
CTX="${IA_CTX:-16384}"
MODELS="$HOME/models"
DEMO="$MODELS/Bonsai-demo"          # Prism fork for Bonsai; discarded 23 nov 2026, only kept so `ia rm bonsai` can delete it
LLAMA_BIN="$(command -v llama || echo "$HOME/.local/bin/llama")"  # llama.cpp normal (llama.app; «llama serve» = llama-server)

# Los que se bajan con -hf quedan en una de estas cachés
HF_CACHES=("$HOME/.cache/huggingface/hub" "$HOME/Library/Caches/llama.cpp")

# Patrones con los que aparece cada modelo en las cachés, y repos
PAT_9B="Ternary-Bonsai-2-9B"        # discarded 23 nov 2026 (ia rm bonsai)
PAT_MIMO="bartowski*MiMo-V2.6-Distill-Qwen-9B-GGUF"   # sin «MTP», para no confundirlo con mimo-mtp
MIMO_REPO="bartowski/MiMo-V2.6-Distill-Qwen-9B-GGUF:Q4_K_M"
PAT_OCR="Xiaomi-OCR-0"
OCR_REPO="prithivMLmods/Xiaomi-OCR-0-GGUF:Q6_K"

# En pruebas (9 nov 2026)
PAT_MIMO_MTP="VitreousCut*MiMo-V2.6-Distill-Qwen-9B-MTP"
MIMO_MTP_REPO="VitreousCut/MiMo-V2.6-Distill-Qwen-9B-MTP-GGUF:Q4_K_M"   # el Q4 de bartowski + cabeza MTP
PAT_DFLASH_QWEN="Qwen3.5-9B-DFlash"
DFLASH_QWEN_REPO="AtomicChat/Qwen3.5-9B-DFlash-GGUF:Q8_0"               # borrador genérico para Qwen3.5-9B
PAT_ORNITH="Ornith-1.5-9B-GGUF"
ORNITH_REPO="ornith-ai/Ornith-1.5-9B-GGUF:Q4_K_M"                       # MIT, trae MTP y visión
PAT_ORNITH_DFLASH="Ornith-1.5-9B-DFlash"
ORNITH_DFLASH_REPO="abenzerps/Ornith-1.5-9B-DFlash-GGUF:Q4_K_M"
PAT_QWOPUS="Qwopus3-5-9B-Coder-Flash"
QWOPUS_REPO="Jackrong/Qwopus3-5-9B-Coder-Flash-GGUF:Q4_K_M"            # Apache 2.0, trae MTP

# Testing (23 nov 2026): faster models for OpenCode
PAT_MELLUM="Mellum2.1-12B-A2.5B-Thinking-GGUF"
MELLUM_REPO="JetBrains/Mellum2.1-12B-A2.5B-Thinking-GGUF"                # Apache 2.0
MELLUM_FILE="mtp/Mellum2.1-12B-A2.5B-Thinking-MTP-Q4_K_M.gguf"           # Q4_K_M + MTP head in one file (8,3 GB)
PAT_INKLING="unsloth--Inkling-2-Mini-GGUF"
INKLING_REPO="unsloth/Inkling-2-Mini-GGUF:UD-Q2_K_XL"                     # Apache 2.0, 9,1 GB (+0,6 GB vision)
INKLING_DSPARK_REPO="unsloth/Inkling-2-Mini-GGUF:Q8_0"                    # dspark-Inkling-2-Mini-Q8_0.gguf (0,4 GB)

# Voice (text to speech). Chatterbox Multilingual V3 won the tts-test on 19 nov 2026.
PAT_VOICE="chatterbox-GGUF"
VOICE_REPO="ggml-org/chatterbox-GGUF:Q8_0"                              # MIT, 23 languages, voice cloning
VOICE_PORT="${IA_VOICE_PORT:-8090}"
VOICE_REF="${IA_VOICE_REF:-$MODELS/voices/ibai.wav}"
VOICE_LOG="$MODELS/voices/server.log"
VOICE_MARK="chatterbox-GGUF"   # how the voice server is told apart from the text models in `ps`
# Discarded in the tts-test (19 nov 2026); only listed so `ia rm` can delete them
PAT_LFM3A="LFM3-Audio-2B-GGUF"
PAT_QWEN3TTS="Qwen3-TTS-12Hz-1.7B-Base-GGUF"

# Embla 1 (Sevren, MIT): no va con llama.cpp, usa su propio motor Metal (embla-metal, MIT).
# El motor se clona y se compila con Swift la primera vez; el modelo (5,6 GB) va a la caché de HF.
PAT_EMBLA="sevren-ai--Embla1-4bit"
EMBLA_DIR="$MODELS/embla-metal"
EMBLA_GIT="https://github.com/sevren-ai/embla-metal"
EMBLA_COMMIT="ee3734ae67eba22008461bef18fd8fecbd2fab85"   # versión revisada el 17 nov 2026

# Muestreo recomendado para programar (Ornith; Qwopus usa el de Qwen3.5)
SAMPLING_CODE=(--temp 0.6 --top-p 0.95 --top-k 20 --min-p 0)

# ---------- finalidad de cada modelo (etiquetas) ----------
# Cambia aquí las etiquetas cuando decidas para qué queda cada modelo.
#   code    programar con agentes (OpenCode)
#   agent   agente general (Hermes), llamadas a herramientas
#   chat    conversar y redactar
#   vision  entender imágenes
#   docs    leer documentos y extraer datos
#   ocr     pasar documentos a texto, muy rápido
#   voice   leer textos en voz alta (texto a voz)
ALL_TAGS="code agent chat vision docs ocr voice"
MODEL_IDS="ornith mellum inkling ocr embla voice"

tags_of() {
  case "$1" in
    ornith) echo "code agent chat vision docs" ;;
    mellum)  echo "code agent chat" ;;
    inkling) echo "code agent chat vision" ;;
    ocr)    echo "ocr docs" ;;
    embla)  echo "chat" ;;   # su servidor no admite herramientas ni imágenes
    voice)  echo "voice" ;;
  esac
}

name_of() {
  case "$1" in
    ornith) echo "Ornith-1.5 9B · MTP, visión, 64K" ;;
    mellum)  echo "Mellum2.1 12B · MoE 2,5B activos, MTP, 64K" ;;
    inkling) echo "Inkling 2 Mini · MoE 26B, 3,4B activos, Q2, 64K" ;;
    ocr)    echo "Xiaomi-OCR-0" ;;
    embla)  echo "Embla 1 · MoE 10B, 1B activo, 256K" ;;
    voice)  echo "Chatterbox · voz clonada, puerto $VOICE_PORT" ;;
  esac
}

testing_of() {  # modelos que aún están en pruebas
  case "$1" in embla|mellum|inkling) return 0 ;; *) return 1 ;; esac
}

fmt_tags() {
  local t out=""
  for t in $(tags_of "$1"); do out="$out #$t"; done
  echo "${out# }"
}

tag_desc() {
  case "$1" in
    code)   echo "programar con agentes (OpenCode)" ;;
    agent)  echo "agente general y herramientas (Hermes)" ;;
    chat)   echo "conversar y redactar" ;;
    vision) echo "entender imágenes" ;;
    docs)   echo "leer documentos y extraer datos" ;;
    ocr)    echo "documentos a texto, muy rápido" ;;
    voice)  echo "leer textos en voz alta" ;;
  esac
}

norm_tag() {  # acepta también los nombres en español: «código», «programar», «documentos»…
  case "$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/^#//')" in
    code|coding|codigo|código|programar) echo code ;;
    agent|agents|agente|agentes|hermes|tools|herramientas) echo agent ;;
    chat|write|writing|redactar|redaccion|redacción|escribir) echo chat ;;
    vision|image|images|visión|imagen|imagenes|imágenes) echo vision ;;
    docs|doc|documents|documento|documentos) echo docs ;;
    ocr|transcribir) echo ocr ;;
    voice|voz|tts|speech|say|hablar|leer) echo voice ;;
    *) echo "" ;;
  esac
}

installed_id() {
  case "$1" in
    ornith) has_ornith ;;
    embla)  has_embla ;;
    mellum)  has_mellum ;;
    inkling) has_inkling ;;
    ocr)    has_ocr ;;
    voice)  has_voice ;;
  esac
}

show_tag() {  # $1 = etiqueta normalizada
  local id found="" ok extra
  echo "#$1 — $(tag_desc "$1")"
  for id in $MODEL_IDS; do
    case " $(tags_of "$id") " in *" $1 "*) ;; *) continue ;; esac
    found=1
    if installed_id "$id"; then ok="✓"; else ok="↓"; fi
    extra=""
    if testing_of "$id"; then extra=" (en pruebas)"; fi
    printf "   %s ia %-7s %s%s\n" "$ok" "$id" "$(name_of "$id")" "$extra"
  done
  [[ -n "$found" ]] || echo "   (ningún modelo)"
}

by_tag() {  # ia tags [tag]
  local t
  if [[ -z "${1:-}" ]]; then
    for t in $ALL_TAGS; do show_tag "$t"; echo; done
    echo "✓ instalado · ↓ se descarga la primera vez"
    return 0
  fi
  t="$(norm_tag "$1")"
  if [[ -z "$t" ]]; then
    echo "No conozco la etiqueta «$1». Opciones: $ALL_TAGS"
    exit 1
  fi
  show_tag "$t"
}

CUR_ID=""   # modelo que se está lanzando (para mostrar sus etiquetas)

case "${IA_SERVER:-}" in
  "")   SERVER=("$LLAMA_BIN" serve) ;;
  *)    SERVER=("$IA_SERVER") ;;
esac

# ---------- comprobaciones ----------

in_hf_cache() {  # $1 = patrón
  local d
  for d in "${HF_CACHES[@]}"; do
    [[ -d "$d" ]] || continue
    if find "$d" -maxdepth 1 -iname "*$1*" 2>/dev/null | grep -q .; then
      return 0
    fi
  done
  return 1
}

has_9b()     { in_hf_cache "$PAT_9B" || [[ -d "$DEMO" ]]; }
has_mellum()  { in_hf_cache "$PAT_MELLUM"; }
has_inkling() { in_hf_cache "$PAT_INKLING"; }
has_mimo()   { in_hf_cache "$PAT_MIMO"; }
has_ocr()    { in_hf_cache "$PAT_OCR"; }
has_mimo_mtp()      { in_hf_cache "$PAT_MIMO_MTP"; }
has_dflash_qwen()   { in_hf_cache "$PAT_DFLASH_QWEN"; }
has_ornith()        { in_hf_cache "$PAT_ORNITH"; }
has_ornith_dflash() { in_hf_cache "$PAT_ORNITH_DFLASH"; }
has_qwopus()        { in_hf_cache "$PAT_QWOPUS"; }
has_embla()         { in_hf_cache "$PAT_EMBLA"; }
has_voice()         { in_hf_cache "$PAT_VOICE"; }
has_lfm3a()         { in_hf_cache "$PAT_LFM3A"; }
has_qwen3tts()      { in_hf_cache "$PAT_QWEN3TTS"; }

old_installed() {
  case "$1" in
    mimo)          has_mimo ;;
    mimo-mtp)      has_mimo_mtp ;;
    qwopus)        has_qwopus ;;
    ornith-dflash) has_ornith_dflash ;;
    dflash-qwen)   has_dflash_qwen ;;
    bonsai)        has_9b ;;
    lfm3-audio)    has_lfm3a ;;
    qwen3-tts)     has_qwen3tts ;;
    *) return 1 ;;
  esac
}

mark() {  # $1 = función de comprobación, $2 = tamaño aproximado de descarga
  if "$1"; then echo "✓"; else echo "↓ se descargará (~$2)"; fi
}

list_installed() {
  echo "Modelos:"
  echo "  ornith  $(mark has_ornith '6,7 GB')   $(fmt_tags ornith)"
  echo "  ocr     $(mark has_ocr '0,9 GB')   $(fmt_tags ocr)"
  echo "  voice   $(mark has_voice '1,2 GB')   $(fmt_tags voice) · referencia: $VOICE_REF"
  echo
  echo "En pruebas:"
  echo "  mellum  $(mark has_mellum '8,3 GB')   $(fmt_tags mellum)"
  echo "  inkling $(mark has_inkling '9,1 GB + 0,6 GB visión')   $(fmt_tags inkling)"
  echo "  embla   $(mark has_embla '5,6 GB + compilar el motor')   $(fmt_tags embla)"
  echo
  # Descartados en ia-bench (9 nov 2026): solo salen si siguen en disco, para borrarlos con ia rm
  local old="" id
  for id in bonsai mimo mimo-mtp qwopus ornith-dflash dflash-qwen lfm3-audio qwen3-tts; do
    if old_installed "$id"; then old="$old $id"; fi
  done
  if [[ -n "$old" ]]; then
    echo "Descartados que siguen en disco (ia rm <nombre> para borrarlos):"
    for id in $old; do echo "  $id"; done
    echo
  fi
  echo "Espacio ocupado:"
  du -sh "$MODELS"/* "${HF_CACHES[@]}" 2>/dev/null | sort -h | sed 's/^/  /' || true
}

# ---------- utilidades ----------

server_pids() {  # $1 = all|text|voice; prints the PIDs of running model servers
  local which="$1" p pid cmd
  for p in "llama-server" "llama serve" "embla serve"; do
    for pid in $(pgrep -f "$p" 2>/dev/null || true); do
      cmd="$(ps -o command= -p "$pid" 2>/dev/null || true)"
      [[ -n "$cmd" ]] || continue
      case "$which:$cmd" in
        all:*) ;;
        voice:*"$VOICE_MARK"*) ;;
        voice:*) continue ;;
        text:*"$VOICE_MARK"*) continue ;;
      esac
      echo "$pid"
    done
  done | sort -u
}

stop_servers() {  # $1 = all|text|voice, $2 = message
  local pids
  pids="$(server_pids "$1")"
  [[ -n "$pids" ]] || return 0
  echo "→ $2"
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  sleep 2
}

stop_all()   { stop_servers all   "Parando lo que estaba en marcha…"; }
stop_text()  { stop_servers text  "Parando el modelo que estaba en marcha…"; }   # leaves the voice running
stop_voice() { stop_servers voice "Parando la voz…"; }

check_memory() {
  if pgrep -fi "mlx ?studio|vmlx" >/dev/null 2>&1; then
    echo "⚠️  MLX Studio está abierto y puede estar ocupando memoria."
    if [[ -z "${IA_YES:-}" ]]; then
      read -r -p "   ¿Continuar igualmente? [s/N] " r
      [[ "$r" =~ ^[sS]$ ]] || exit 1
    fi
  fi
  echo "   Swap ahora: $(sysctl -n vm.swapusage)"
}

banner() {
  echo
  echo "=== $1 ==="
  echo "   Chat:  http://localhost:$PORT"
  echo "   API:   http://localhost:$PORT/v1"
  echo "   Contexto: $CTX tokens · Ctrl+C para parar"
  if [[ -n "$CUR_ID" ]]; then echo "   Para: $(fmt_tags "$CUR_ID")"; fi
  echo
}

need() {
  [[ -e "$1" ]] || { echo "✗ No encuentro $1"; exit 1; }
}

# ---------- borrar ----------

TARGETS=()

collect_cache() {  # añade a TARGETS lo que haya en las cachés con ese patrón
  local d f
  for d in "${HF_CACHES[@]}"; do
    [[ -d "$d" ]] || continue
    while IFS= read -r f; do
      TARGETS+=("$f")
    done < <(find "$d" -maxdepth 1 -iname "*$1*" 2>/dev/null)
  done
}

add_if_exists() {
  local p
  for p in "$@"; do
    if [[ -e "$p" ]]; then TARGETS+=("$p"); fi
  done
}

delete_model() {  # $1 = mimo|9b|ocr
  TARGETS=()
  local label
  case "$1" in
    mimo)   label="MiMo-V2.6 9B";  collect_cache "$PAT_MIMO" ;;
    bonsai|9b|hermes) label="Bonsai 2 9B y el fork de Prism (~/models/Bonsai-demo)"; collect_cache "$PAT_9B"; add_if_exists "$DEMO" ;;
    mellum)        label="Mellum2.1 12B";                   collect_cache "$PAT_MELLUM" ;;
    inkling)       label="Inkling 2 Mini (y su borrador)";  collect_cache "$PAT_INKLING" ;;
    ocr)    label="Xiaomi-OCR-0";  collect_cache "$PAT_OCR" ;;
    mimo-mtp)      label="MiMo con MTP (VitreousCut)";      collect_cache "$PAT_MIMO_MTP" ;;
    dflash-qwen)   label="borrador DFlash de Qwen3.5-9B";   collect_cache "$PAT_DFLASH_QWEN" ;;
    ornith)        label="Ornith-1.5 9B";                   collect_cache "$PAT_ORNITH" ;;
    ornith-dflash) label="borrador DFlash de Ornith";       collect_cache "$PAT_ORNITH_DFLASH" ;;
    qwopus)        label="Qwopus3.5 9B Coder Flash";        collect_cache "$PAT_QWOPUS" ;;
    embla)         label="Embla 1 (modelo y motor embla-metal)"; collect_cache "$PAT_EMBLA"; add_if_exists "$EMBLA_DIR" ;;
    voice|voz)     label="Chatterbox (voz; la referencia de ~/models/voices se conserva)"; collect_cache "$PAT_VOICE" ;;
    lfm3-audio)    label="LFM3-Audio 2B (voz descartada)";   collect_cache "$PAT_LFM3A" ;;
    qwen3-tts)     label="Qwen3-TTS 1.7B (voz descartada)";  collect_cache "$PAT_QWEN3TTS" ;;
    *) echo "Uso: ia rm [ornith|mellum|inkling|ocr|voice|bonsai|mimo|mimo-mtp|dflash-qwen|ornith-dflash|qwopus|lfm3-audio|qwen3-tts]"; exit 1 ;;
  esac

  if [[ ${#TARGETS[@]} -eq 0 ]]; then
    echo "No hay nada de $label instalado."
    return 0
  fi

  echo "Se borrará ($label):"
  du -sh "${TARGETS[@]}" 2>/dev/null | sed 's/^/  /' || true
  read -r -p "¿Borrar definitivamente? (no pasa por la Papelera) [s/N] " r
  if [[ "$r" =~ ^[sS]$ ]]; then
    stop_all
    rm -rf "${TARGETS[@]}"
    echo "✓ $label borrado. Se volverá a descargar si lo lanzas otra vez."
  else
    echo "Cancelado."
  fi
}

delete_menu() {
  echo "¿Qué modelo borro?"
  has_mimo   && echo "  1) MiMo-V2.6 9B"
  has_9b     && echo "  2) Bonsai 2 9B y fork de Prism (descartado)"
  has_ocr    && echo "  3) Xiaomi-OCR-0"
  has_ornith && echo "  4) Ornith-1.5 9B"
  has_qwopus && echo "  5) Qwopus3.5 9B Coder Flash"
  has_mimo_mtp && echo "  6) MiMo con MTP"
  has_ornith_dflash && echo "  7) Borrador DFlash de Ornith"
  has_dflash_qwen && echo "  8) Borrador DFlash de Qwen3.5-9B"
  has_voice && echo "  9) Chatterbox (voz)"
  has_lfm3a && echo "  10) LFM3-Audio 2B (voz descartada)"
  has_qwen3tts && echo "  11) Qwen3-TTS 1.7B (voz descartada)"
  has_mellum && echo "  12) Mellum2.1 12B"
  has_inkling && echo "  13) Inkling 2 Mini"
  echo "  q) Volver"
  read -r -p "> " opt
  case "$opt" in
    1) delete_model mimo ;;
    2) delete_model bonsai ;;
    3) delete_model ocr ;;
    4) delete_model ornith ;;
    5) delete_model qwopus ;;
    6) delete_model mimo-mtp ;;
    7) delete_model ornith-dflash ;;
    8) delete_model dflash-qwen ;;
    9) delete_model voice ;;
    10) delete_model lfm3-audio ;;
    11) delete_model qwen3-tts ;;
    12) delete_model mellum ;;
    13) delete_model inkling ;;
    *) exit 0 ;;
  esac
}

# ---------- decodificación especulativa ----------

SPEC=()
SPEC_LABEL=""

check_spec() {  # $1 = tipo de --spec-type
  if ! "${SERVER[@]}" --help 2>&1 | grep -q -- "$1"; then
    echo "✗ Este servidor no conoce --spec-type $1."
    echo "  Actualiza llama.cpp (llama update)."
    exit 1
  fi
}

spec_args() {  # $1 = modo (vacío|none|mtp|dflash|dspark|ngram), $2 = repo del borrador, $3 = modos válidos
  SPEC=(); SPEC_LABEL=""
  local mode="$1" draft="$2" ok=" $3 "
  case "$mode" in ""|none) return 0 ;; esac
  if [[ "$ok" != *" $mode "* ]]; then
    echo "✗ Modo «${mode}» no disponible para este modelo. Opciones: $3"
    exit 1
  fi
  case "$mode" in
    mtp)
      check_spec draft-mtp
      SPEC=(--spec-type draft-mtp --spec-draft-n-max "${IA_SPEC_N:-2}")
      SPEC_LABEL="MTP (n=${IA_SPEC_N:-2})" ;;
    dflash)
      check_spec draft-dflash
      SPEC=(-hfd "$draft" --spec-type draft-dflash --spec-draft-n-max "${IA_SPEC_N:-8}")
      SPEC_LABEL="DFlash (n=${IA_SPEC_N:-8})" ;;
    dspark)
      check_spec draft-dspark
      SPEC=(-hfd "$draft" --spec-type draft-dspark --spec-draft-n-max "${IA_SPEC_N:-8}")
      SPEC_LABEL="DSpark (n=${IA_SPEC_N:-8})" ;;
    ngram)
      check_spec ngram-mod
      SPEC=(--spec-type ngram-mod)
      SPEC_LABEL="ngram-mod" ;;
  esac
}

# serve ETIQUETA REPO MODO REPO_BORRADOR MODOS_VÁLIDOS [argumentos extra de llama-server…]
serve() {
  local label="$1" repo="$2" mode="$3" draft="$4" modes="$5"; shift 5
  need "${SERVER[0]}"
  CTX="${IA_CTX:-65536}"
  local kv="${IA_KV:-q8_0}" args=()
  spec_args "$mode" "$draft" "$modes"
  # Sin visión si se pide, o en modo especulativo (salvo IA_VISION=1)
  if [[ -n "${IA_NOVISION:-}" ]] || { [[ -n "$SPEC_LABEL" ]] && [[ -z "${IA_VISION:-}" ]]; }; then
    args+=(--no-mmproj)
  fi
  # Límite de razonamiento: al agotarse, el modelo cierra el bloque de pensar y responde
  if [[ -n "${IA_THINK:-}" ]]; then
    if ! "${SERVER[@]}" --help 2>&1 | grep -q -- "--reasoning-budget-message"; then
      echo "✗ Este servidor no admite un presupuesto de razonamiento en tokens. Actualiza llama.cpp (llama update)."
      exit 1
    fi
    args+=(--reasoning-budget "$IA_THINK")
    if [[ "$IA_THINK" != "-1" && "$IA_THINK" != "0" ]]; then
      args+=(--reasoning-budget-message "Ya he pensado suficiente; escribo la respuesta.")
      label="$label · pensar ≤ $IA_THINK"
    fi
  fi
  stop_text; check_memory
  if [[ -n "$SPEC_LABEL" ]]; then label="$label · $SPEC_LABEL"; fi
  banner "$label · caché KV $kv"
  exec "${SERVER[@]}" -hf "$repo" ${args[@]+"${args[@]}"} ${SPEC[@]+"${SPEC[@]}"} "$@" \
    -c "$CTX" -np 1 --port "$PORT" --jinja --alias local \
    -fa on --cache-type-k "$kv" --cache-type-v "$kv"
}

# ---------- lanzar ----------

run_ornith() {
  # Ornith-1.5-9B (MIT): Qwen3.5-9B con RL para código y agentes. Q4_K_M (5,8 GB)
  # + visión (0,9 GB). Trae cabeza MTP y tiene borrador DFlash oficial.
  # Configuración ganadora en ia-bench (9 nov 2026): MTP + visión + pensar ≤ 2048.
  #   - MTP: ~1,35× más rápido, ~80 % de aceptación, compatible con la visión.
  #   - Sin límite piensa 2.500-4.000 tokens y se cortaba; con 2048, código 7/7 en 3 de 3.
  CUR_ID=ornith
  local mode="${1:-${IA_SPEC:-mtp}}"
  if [[ "$mode" == "base" ]]; then mode=none; fi
  IA_THINK="${IA_THINK:-2048}"
  if [[ -z "${IA_NOVISION:-}" ]]; then IA_VISION="${IA_VISION:-1}"; fi
  has_ornith || echo "↓ Primera vez: descargando Ornith-1.5 9B (~6,7 GB con visión)…"
  if [[ "$mode" == "dflash" ]] && ! has_ornith_dflash; then
    echo "↓ Primera vez: descargando el borrador DFlash de Ornith (~0,8 GB)…"
  fi
  serve "Ornith-1.5 9B" "$ORNITH_REPO" "$mode" \
    "$ORNITH_DFLASH_REPO" "mtp dflash ngram" "${SAMPLING_CODE[@]}"
}

run_mellum() {
  # Mellum2.1 Thinking (JetBrains, Apache 2.0): MoE 12B, 2,5B active, trained for agentic coding.
  # One file holds Q4_K_M and the MTP head (8,3 GB), so `base` reuses it without the head.
  # No vision. Sampling from the model card. In testing since 23 nov 2026.
  CUR_ID=mellum
  local mode="${1:-${IA_SPEC:-mtp}}"
  if [[ "$mode" == "base" ]]; then mode=none; fi
  IA_THINK="${IA_THINK:-2048}"
  IA_NOVISION=1
  has_mellum || echo "↓ Primera vez: descargando Mellum2.1 12B con MTP (~8,3 GB)…"
  serve "Mellum2.1 12B" "$MELLUM_REPO" "$mode" "" "mtp" \
    -hff "$MELLUM_FILE" "${SAMPLING_CODE[@]}"
}

run_inkling() {
  # Inkling 2 Mini (Thinking Machines, Apache 2.0): looped MoE, 26,4B total, 3,4B active
  # (~5,4B effective). The lab asks for 32 GB; here only unsloth's UD-Q2_K_XL fits (9,1 GB).
  # Vision off by default to save 0,6 GB (IA_VISION=1 turns it on). Optional DSpark draft.
  # In testing since 23 nov 2026.
  CUR_ID=inkling
  local mode="${1:-${IA_SPEC:-none}}"
  if [[ "$mode" == "base" ]]; then mode=none; fi
  IA_THINK="${IA_THINK:-2048}"
  if [[ -z "${IA_VISION:-}" ]]; then IA_NOVISION=1; fi
  has_inkling || echo "↓ Primera vez: descargando Inkling 2 Mini Q2 (~9,1 GB, +0,6 GB con visión)…"
  serve "Inkling 2 Mini (Q2)" "$INKLING_REPO" "$mode" "$INKLING_DSPARK_REPO" "dspark"
}

run_embla() {
  # Embla 1 (Sevren, MIT): MoE para móviles, 10B en total (3B son una tabla «engram» que
  # se lee del disco) y 1B activo por token; entrenado para 4 bits. Sin herramientas ni visión.
  CUR_ID=embla
  local bin="$EMBLA_DIR/.build/release/embla"
  if [[ ! -x "$bin" ]]; then
    command -v git >/dev/null 2>&1 || { echo "✗ Falta git (xcode-select --install)"; exit 1; }
    command -v swift >/dev/null 2>&1 || {
      echo "✗ Falta Swift para compilar el motor de Embla. Instala las Command Line Tools:"
      echo "    xcode-select --install"
      exit 1
    }
    if [[ ! -d "$EMBLA_DIR/.git" ]]; then
      echo "↓ Primera vez: clonando embla-metal en ${EMBLA_DIR}…"
      git clone --quiet "$EMBLA_GIT" "$EMBLA_DIR"
    fi
    git -C "$EMBLA_DIR" fetch --quiet origin || true
    git -C "$EMBLA_DIR" -c advice.detachedHead=false checkout --quiet "$EMBLA_COMMIT"
    echo "⚙︎ Compilando el motor de Embla (la primera vez tarda un par de minutos)…"
    (cd "$EMBLA_DIR" && swift build -c release --product embla)
  fi
  if ! has_embla; then
    echo "↓ Primera vez: descargando Embla 1 (~5,6 GB)…"
    "$bin" download
  fi
  # Contexto máximo del modelo (256K): la caché KV de Embla ocupa ~2,6 KB por token (~0,7 GB llena)
  CTX="${IA_CTX:-262144}"
  stop_text; check_memory
  banner "Embla 1 · MoE 10B, 1B activo · solo chat (sin herramientas ni imágenes)"
  exec "$bin" serve --port "$PORT" --context "$CTX"
}

run_ocr() {
  # Xiaomi-OCR-0 (0,8B, Apache 2.0). Q6_K + visión (~0,9 GB).
  # Prompt recomendado: "Extract all information from the main body of the document
  # image and represent it in markdown format…" (ver ia-bench).
  CUR_ID=ocr
  need "$LLAMA_BIN"
  has_ocr || echo "↓ Primera vez: descargando Xiaomi-OCR-0 (~0,9 GB)…"
  CTX="${IA_CTX:-16384}"
  stop_text; check_memory
  banner "Xiaomi-OCR-0 · documentos a Markdown"
  exec "$LLAMA_BIN" serve -hf "$OCR_REPO" -c "$CTX" -np 1 --port "$PORT" -fa on --jinja --alias local \
    --chat-template-kwargs '{"enable_thinking":false}'
}

# ---------- voice (text to speech) ----------

voice_up() { curl -sf "http://127.0.0.1:$VOICE_PORT/health" >/dev/null 2>&1; }

run_voice() {
  # Chatterbox Multilingual V3 (MIT): Q8_0 (0,6 GB) + codec/voice encoder (0,6 GB), ~2,4 GB in use.
  # tts-test (19 nov 2026): ~real time (RTF 1,1) cloning the reference voice; the best-sounding one.
  # It has its own port so it can run next to a text model. Note: llama serve does not do the
  # classifier-free guidance of the multilingual model yet (llama tts does); it already sounds good.
  CUR_ID=voice
  need "$LLAMA_BIN"
  has_voice || echo "↓ Primera vez: descargando Chatterbox (~1,2 GB)…"
  if [[ ! -f "$VOICE_REF" ]]; then
    echo "⚠️  No encuentro la voz de referencia $VOICE_REF: «ia say» usará la voz propia del modelo."
  fi
  stop_voice; check_memory
  echo
  echo "=== Chatterbox · voz (texto a voz) ==="
  echo "   API:   http://localhost:$VOICE_PORT/tts y /v1/audio/speech"
  echo "   Voz:   $VOICE_REF"
  echo "   Úsala con: ia say \"texto\" · Ctrl+C para parar"
  echo
  exec "$LLAMA_BIN" serve -hf "$VOICE_REPO" --port "$VOICE_PORT" -np 1 -c 8192 --tts-lang es
}

ensure_voice() {  # starts the voice server in the background if it is not running
  voice_up && return 0
  local waited=0
  if [[ -z "$(server_pids voice)" ]]; then
    echo "→ Arrancando la voz en segundo plano (log: $VOICE_LOG)…"
    mkdir -p "$(dirname "$VOICE_LOG")"
    IA_YES=1 nohup "$0" voice > "$VOICE_LOG" 2>&1 &
  else
    echo "→ La voz se está cargando…"
  fi
  while (( waited < 900 )); do
    voice_up && return 0
    if [[ -z "$(server_pids voice)" ]] && (( waited > 5 )); then
      echo "✗ La voz no arrancó. Mira $VOICE_LOG"
      tail -5 "$VOICE_LOG" 2>/dev/null | sed 's/^/   /'
      exit 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "✗ La voz no estaba lista tras ${waited}s. Mira $VOICE_LOG"
  exit 1
}

voice_request() {  # $1 = text, $2 = output wav
  local body code ref=""
  body="$(mktemp "${TMPDIR:-/tmp}/ia-say-body.XXXXXX")"
  [[ -f "$VOICE_REF" ]] && ref="$VOICE_REF"
  perl -CSDA -MJSON::PP -MMIME::Base64 -e '
    my ($text, $ref) = @ARGV;
    my %req = (input => $text, lang => "es", n_predict => 1500);
    if ($ref ne "") {
      open(my $f, "<:raw", $ref) or die "cannot read $ref\n";
      local $/; $req{speaker_ref_b64} = encode_base64(<$f>, "");
    }
    print JSON::PP->new->ascii->canonical->encode(\%req);
  ' -- "$1" "$ref" > "$body"
  code="$(curl -s -X POST "http://127.0.0.1:$VOICE_PORT/tts" -H "Content-Type: application/json" \
    -d @"$body" -o "$2" -w '%{http_code}')" || code="000"
  rm -f "$body"
  if [[ "$code" != "200" ]]; then
    echo "✗ La voz respondió HTTP $code: $(head -c 300 "$2" 2>/dev/null)"
    return 1
  fi
}

resolve_voice() {  # $1 = name in ~/models/voices or a path to an audio file
  local v="$1" d="$MODELS/voices" ext
  if [[ -f "$v" ]]; then echo "$v"; return 0; fi
  for ext in wav mp3 flac m4a; do
    if [[ -f "$d/$v.$ext" ]]; then echo "$d/$v.$ext"; return 0; fi
  done
  echo "✗ No encuentro la voz «${v}» (ni como archivo ni en ${d}). Mira: ia voice list" >&2
  return 1
}

list_voices() {
  local d="$MODELS/voices" f found=""
  echo "Voces de referencia en $d (por defecto: $(basename "$VOICE_REF")):"
  for f in "$d"/*.wav "$d"/*.mp3 "$d"/*.flac "$d"/*.m4a; do
    [[ -f "$f" ]] || continue
    found=1
    echo "  $(basename "${f%.*}")"
  done
  [[ -n "$found" ]] || echo "  (ninguna)"
  echo "Úsalas con: ia say -v <nombre> \"texto\". Para añadir una, copia un .wav de 10-20 s ahí."
}

say_text() {  # ia say [-v voice] "text"  ·  pbpaste | ia say [-v voice]
  local text tmp chunk i=0 player=""
  if [[ "${1:-}" == "-v" || "${1:-}" == "--voice" ]]; then
    [[ -n "${2:-}" ]] || { echo "Uso: ia say -v <voz> \"texto\""; exit 1; }
    VOICE_REF="$(resolve_voice "$2")" || exit 1
    shift 2
  fi
  if [[ $# -gt 0 ]]; then text="$*"; elif [[ ! -t 0 ]]; then text="$(cat)"; else text=""; fi
  if [[ -z "${text//[[:space:]]/}" ]]; then
    echo "Uso: ia say [-v voz] \"texto\"   (o: pbpaste | ia say)"
    exit 1
  fi
  ensure_voice
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/ia-say.XXXXXX")"
  # Chunks: the first sentence alone (so it starts sounding soon), then up to ~220 characters each.
  printf '%s' "$text" | perl -CSD -0777 -ne '
    s/\s+/ /g; s/^ | $//g;
    my ($buf, $first) = ("", 1);
    for my $s (split /(?<=[.!?:;])\s+/) {
      if ($first) { print "$s\n"; $first = 0; next }
      if (length($buf) && length($buf) + length($s) > 220) { print "$buf\n"; $buf = $s }
      else { $buf = length($buf) ? "$buf $s" : $s }
    }
    print "$buf\n" if length $buf;
  ' > "$tmp/chunks.txt"
  # While one chunk plays, the next one is being generated.
  while IFS= read -r chunk; do
    [[ -n "$chunk" ]] || continue
    i=$((i + 1))
    if ! voice_request "$chunk" "$tmp/$i.wav"; then break; fi
    if [[ -n "$player" ]]; then wait "$player" || true; fi
    afplay "$tmp/$i.wav" &
    player=$!
  done < "$tmp/chunks.txt"
  if [[ -n "$player" ]]; then wait "$player" || true; fi
  rm -rf "$tmp"
}

# ---------- menú ----------

menu() {
  echo "¿Qué hago?"
  echo "  1) Ornith-1.5 9B   $(mark has_ornith '6,7 GB')   $(fmt_tags ornith)"
  echo "  2) Xiaomi-OCR      $(mark has_ocr '0,9 GB')   $(fmt_tags ocr)"
  echo "  3) Voz (Chatterbox) $(mark has_voice '1,2 GB')   $(fmt_tags voice) (puerto $VOICE_PORT)"
  echo "  En pruebas:"
  echo "  4) Mellum2.1 12B   $(mark has_mellum '8,3 GB')   $(fmt_tags mellum)"
  echo "  5) Inkling 2 Mini  $(mark has_inkling '9,1 GB')   $(fmt_tags inkling)"
  echo "  6) Embla 1         $(mark has_embla '5,6 GB')   $(fmt_tags embla)"
  echo "  t) ¿Qué uso para…? (modelos por etiqueta)"
  echo "  l) Ver instalados y espacio ocupado"
  echo "  b) Borrar un modelo"
  echo "  p) Parar el modelo en marcha"
  echo "  q) Salir"
  read -r -p "> " opt
  case "$opt" in
    1) run_ornith ;;
    2) run_ocr ;;
    3) run_voice ;;
    4) run_mellum ;;
    5) run_inkling ;;
    6) run_embla ;;
    t|T) by_tag ;;
    l|L) list_installed ;;
    b|B) delete_menu ;;
    p|P) stop_all; echo "Listo." ;;
    *) exit 0 ;;
  esac
}

case "${1:-}" in
  ornith)        run_ornith "${2:-}" ;;
  mellum)        run_mellum "${2:-}" ;;
  inkling)       run_inkling "${2:-}" ;;
  embla)         run_embla ;;
  voice|voz)     case "${2:-}" in stop) stop_voice; echo "Listo." ;; list) list_voices ;; *) run_voice ;; esac ;;
  say)           shift; say_text ${@+"$@"} ;;
  mimo|qwopus)   echo "«$1» se descartó en ia-bench (9 nov 2026); usa «ia ornith». Para borrarlo: ia rm $1"; exit 1 ;;
  hermes|agent|9b) echo "Bonsai (ia $1) se quitó el 23 nov 2026; usa «ia ornith». Para borrarlo del disco: ia rm bonsai"; exit 1 ;;
  ocr|ocrx)      run_ocr ;;
  tags|tag|for)  by_tag "${2:-}" ;;
  list)          list_installed ;;
  rm)            delete_model "${2:-}" ;;
  stop)          stop_all; echo "Listo." ;;
  "")            menu ;;
  *)             echo "Uso: ia [ornith [base|dflash|ngram]|mellum [base]|inkling [dspark]|ocr|voice [stop|list]|say [-v voz] \"texto\"|tags [tag]|list|rm <modelo>|stop]"; exit 1 ;;
esac
