#!/usr/bin/env python3
# ia-bench — compara los modelos del lanzador `ia` en este Mac.
#
# Lanza cada modelo con `ia <modelo>`, le pasa las mismas pruebas y guarda
# respuestas, velocidad y puntuaciones en <salida>/<fecha>/. La salida es $IA_BENCH_OUT si
# existe; si no, ~/git/ops/inventory/modelos/bench (carpeta sin versionar de ops) cuando hay
# un clon de ops, y si tampoco, ~/models/bench/resultados. Las páginas de prueba siguen en
# ~/models/bench/test.
#
# Uso:
#   ia-bench                          → los modelos principales (descarga los que falten)
#   ia-bench mellum mellum-mtp        → solo esos (variantes incluidas)
#   ia-bench --installed-only         → salta los que no estén descargados
#   ia-bench --code-runs 3            → repite la prueba de código N veces
#   ia-bench --max-tokens 4096        → límite de tokens por respuesta (por defecto 8192:
#                                       Mellum piensa hasta 4096 y luego responde)
#   ia-bench --fast                   → menos tokens (1500), para una pasada rápida
#
# Pruebas
#   doc       (modelos con visión): transcribir la página y extraer campos a JSON.
#   texto     (chat y agentes): razonar sobre el documento, programar (se ejecutan
#             tests de verdad), llamar herramientas y redactar un correo.
#   velocidad (variantes con borrador): código una vez + correo, para comparar
#             tok/s con el modelo base («×base») y ver la aceptación del borrador.
#
# Para añadir un modelo: entrada en MODELOS y su tamaño en TAMANOS.
# Reconstruido el 18 nov 2026 (el 17 nov un chezmoi apply pisó la versión anterior).
#
# Solo usa la biblioteca estándar de Python (vale el python3 de macOS).

import base64
import datetime
import glob
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
BENCH = os.path.join(HOME, "models", "bench")
TEST_DIR = os.path.join(BENCH, "test")
OPS = os.path.join(HOME, "git", "ops")


def results_root():
    # Results live next to the review workflow (ops, git-ignored) so one folder is enough to evaluate them.
    out = os.environ.get("IA_BENCH_OUT")
    if out:
        return os.path.expanduser(out)
    if os.path.isdir(os.path.join(OPS, ".git")):
        return os.path.join(OPS, "inventory", "modelos", "bench")
    return os.path.join(BENCH, "resultados")

PORT = int(os.environ.get("IA_PORT", "8080"))
BASE = "http://127.0.0.1:%d" % PORT
IA = os.environ.get("IA_BIN") or shutil.which("ia") or os.path.join(HOME, ".local", "bin", "ia")

# Each entry: name in the results, description, `ia` arguments, tests,
# extra environment, base model for «×base» (or None), id in `ia list`, default run.
MODELOS = [
    {"nombre": "mellum", "descripcion": "Mellum2.1 12B-A2.5B (pensar ≤ 4096)",
     "ia": ["mellum"], "pruebas": ["texto"], "lista": "mellum", "defecto": True},
    {"nombre": "mellum-mtp", "descripcion": "Mellum2.1 12B-A2.5B con MTP",
     "ia": ["mellum", "mtp"], "pruebas": ["velocidad"], "base": "mellum", "lista": "mellum"},
    {"nombre": "ocr", "descripcion": "Xiaomi-OCR-0 (0,8B)",
     "ia": ["ocr"], "pruebas": ["doc"], "lista": "ocr", "defecto": True},
    {"nombre": "embla", "descripcion": "Embla 1 (MoE 10B, 1B activo)",
     "ia": ["embla"], "pruebas": ["texto"], "lista": "embla"},
]
TAMANOS = {"mellum": 8.1, "ocr": 0.9, "embla": 5.6}  # GB to download, by `ia list` id

# Server processes that `ia` can start (pgrep/pkill -f take an extended regex)
PATRON_SERVIDOR = os.environ.get("IA_BENCH_PATRON", "llama-server|llama serve|embla serve")

# Prompt de transcripción que recomienda cada modelo de OCR
PROMPT_TRANSCRIBIR = {
    "ocr": ("Extract all information from the main body of the document image and represent it "
            "in markdown format, ignoring headers and footers. Tables should be expressed in OTSL "
            "format, formulas in the document should be represented using LATEX format, and the "
            "parsing should be organized according to the reading order."),
}
PROMPT_TRANSCRIBIR_GENERAL = ("Transcribe todo el texto de este documento a Markdown, respetando "
                              "las tablas. No resumas, no traduzcas y no añadas comentarios.")

# ---------------------------------------------------------------- referencia

CAMPOS = {  # lo que tiene que salir al extraer el documento de prueba
    "referencia_catastral": "5051914DR5755S0001DT",
    "direccion": "CL GUELDERA 4 P.R.STA.CRUZ DEL ROMERAL",
    "codigo_postal": "35107",
    "municipio": "SAN BARTOLOME DE TIRAJANA",
    "clase": "URBANO",
    "uso_principal": "Residencial",
    "superficie_construida_m2": "117",
    "anio_construccion": "2004",
    "superficie_parcela_m2": "149",
    "tipo_parcela": "Parcela construida sin division horizontal",
    "registro": "SAN BARTOLOME DE TIRAJANA 1",
    "codigo_registral_unico": "35012000242270",
    "fecha_coordinacion": "16/03/2016",
}
# trozos que una transcripción completa debería contener
CLAVES_TRANSCRIPCION = [
    "CONSULTA DESCRIPTIVA Y GRAFICA", "5051914DR5755S0001DT", "CL GUELDERA 4",
    "P.R.STA.CRUZ DEL ROMERAL", "35107", "SAN BARTOLOME DE TIRAJANA", "LAS PALMAS",
    "URBANO", "Residencial", "117 m2", "2004", "VIVIENDA", "1/00/01", "1/01/01",
    "1/00/02", "1/01/02", "149 m2", "Parcela construida sin division horizontal",
    "SAN BARTOLOME DE TIRAJANA 1", "35012000242270", "16/03/2016",
    "20 de Octubre de 2026",
]
FILAS_TABLA = [("1/00/01", "56"), ("1/01/01", "39"), ("1/00/02", "9"), ("1/01/02", "13")]


def norm(s):
    s = unicodedata.normalize("NFKD", str(s))
    s = "".join(c for c in s if not unicodedata.combining(c))
    s = s.replace("²", "2").lower()
    return re.sub(r"\s+", " ", s).strip()


def solo_digitos(s):
    return re.sub(r"\D", "", str(s))

# ---------------------------------------------------------------- utilidades


def log(msg=""):
    print(msg, flush=True)


def http_json(method, path, body=None, timeout=1800):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode() or "{}")


def servidor_listo():
    # /health alone is not enough: on 23 nov 2026 another program on the port answered /health
    # with 200 and every test got a 404. The model server must also list its models.
    try:
        with urllib.request.urlopen(BASE + "/health", timeout=3) as r:
            if r.status != 200:
                return False
        with urllib.request.urlopen(BASE + "/v1/models", timeout=3) as r:
            datos = json.loads(r.read().decode() or "{}")
            return r.status == 200 and bool(datos.get("data") or datos.get("models"))
    except Exception:
        return False


def ia(*args, **kw):
    env = dict(os.environ, IA_YES="1", IA_PORT=str(PORT))
    return subprocess.run([IA] + list(args), env=env, capture_output=True, text=True, **kw)


def instalado(nombre):
    r = ia("list")
    for linea in r.stdout.splitlines():
        partes = linea.split()
        if len(partes) >= 2 and partes[0] == nombre:
            return "✓" in linea
    return False


def swap_mb():
    try:
        out = subprocess.run(["sysctl", "-n", "vm.swapusage"], capture_output=True, text=True).stdout
        m = re.search(r"used = ([\d.,]+)M", out)
        return float(m.group(1).replace(",", ".")) if m else None
    except Exception:
        return None


def rss_servidor_mb():
    try:
        pids = subprocess.run(["pgrep", "-f", PATRON_SERVIDOR], capture_output=True, text=True).stdout.split()
        total = 0
        for pid in pids:
            out = subprocess.run(["ps", "-o", "rss=", "-p", pid], capture_output=True, text=True).stdout.strip()
            if out:
                total += int(out)
        return round(total / 1024) if total else None
    except Exception:
        return None


def version_llama():
    exe = shutil.which("llama") or os.path.join(HOME, ".local", "bin", "llama")
    try:
        out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=20)
        txt = (out.stdout + out.stderr).strip().splitlines()
        return " ".join(l for l in txt if "version" in l.lower())[:200] or "?"
    except Exception:
        return "no encontrado"


def chat(messages, max_tokens, temperature=None, tools=None, extra=None):
    body = {"messages": messages, "max_tokens": max_tokens, "stream": False}
    if temperature is not None:
        body["temperature"] = temperature
    if tools:
        body["tools"] = tools
    if extra:
        body.update(extra)
    t0 = time.time()
    try:
        r = http_json("POST", "/v1/chat/completions", body)
    except urllib.error.HTTPError as e:
        return {"error": "HTTP %d: %s" % (e.code, e.read().decode(errors="replace")[:500]),
                "segundos": round(time.time() - t0, 1)}
    except Exception as e:
        return {"error": repr(e), "segundos": round(time.time() - t0, 1)}
    seg = time.time() - t0
    msg = (r.get("choices") or [{}])[0].get("message", {}) or {}
    t = r.get("timings") or {}
    u = r.get("usage") or {}
    gen = t.get("predicted_n") or u.get("completion_tokens") or 0
    return {
        "draft_n": t.get("draft_n"),
        "draft_aceptados": t.get("draft_n_accepted"),
        "contenido": msg.get("content") or "",
        "razonamiento": msg.get("reasoning_content") or "",
        "tool_calls": msg.get("tool_calls") or [],
        "fin": (r.get("choices") or [{}])[0].get("finish_reason"),
        "segundos": round(seg, 1),
        "tokens_prompt": t.get("prompt_n") or u.get("prompt_tokens"),
        "tokens_generados": gen,
        "tok_s_prompt": round(t["prompt_per_second"], 1) if t.get("prompt_per_second") else None,
        "tok_s_generacion": round(t["predicted_per_second"], 1) if t.get("predicted_per_second")
        else (round(gen / seg, 1) if gen and seg else None),
    }


def imagen_data_url(ruta):
    with open(ruta, "rb") as f:
        return "data:image/png;base64," + base64.b64encode(f.read()).decode()


def bloque_json(texto):
    """Último objeto JSON del texto (quita ```json … ``` si lo hay)."""
    candidatos = re.findall(r"\{.*?\}", texto or "", flags=re.S)
    for c in reversed(re.findall(r"\{[\s\S]*\}", texto or "") + candidatos):
        try:
            return json.loads(c)
        except Exception:
            continue
    return None

# ---------------------------------------------------------------- pruebas: documento


def prueba_transcribir(nombre, paginas):
    prompt = PROMPT_TRANSCRIBIR.get(nombre, PROMPT_TRANSCRIBIR_GENERAL)
    contenido = [{"type": "image_url", "image_url": {"url": imagen_data_url(p)}} for p in paginas]
    contenido.append({"type": "text", "text": prompt})
    r = chat([{"role": "user", "content": contenido}], max_tokens=3000, temperature=0,
             extra={"chat_template_kwargs": {"enable_thinking": False}})
    texto = norm(r.get("contenido", ""))
    aciertos = [k for k in CLAVES_TRANSCRIPCION if norm(k) in texto]
    filas = sum(1 for cod, sup in FILAS_TABLA
                if re.search(re.escape(cod) + r"[^0-9]{1,40}" + sup + r"\b", texto))
    r["puntos"] = round(100 * (len(aciertos) + filas) / (len(CLAVES_TRANSCRIPCION) + len(FILAS_TABLA)))
    r["faltan"] = [k for k in CLAVES_TRANSCRIPCION if k not in aciertos]
    r["filas_tabla_ok"] = filas
    return r


def prueba_extraer(nombre, paginas):
    claves = list(CAMPOS)
    lista = ", ".join('"%s"' % k for k in claves)
    prompt = ("Extract the %s. Format the output as a JSON object with keys: %s. "
              "If an item is not in the image, use \"###\"." % (lista, lista))
    contenido = [{"type": "image_url", "image_url": {"url": imagen_data_url(p)}} for p in paginas]
    contenido.append({"type": "text", "text": prompt})
    r = chat([{"role": "user", "content": contenido}], max_tokens=1200, temperature=0,
             extra={"chat_template_kwargs": {"enable_thinking": False}})
    datos = bloque_json(r.get("contenido", "")) or {}
    ok, mal = [], {}
    for k, esperado in CAMPOS.items():
        v = datos.get(k, "")
        if k.endswith("_m2") or k in ("anio_construccion", "codigo_postal", "codigo_registral_unico"):
            bien = solo_digitos(v).startswith(solo_digitos(esperado)) and solo_digitos(esperado) != ""
        elif k == "fecha_coordinacion":
            bien = solo_digitos(v) == solo_digitos(esperado)
        else:
            bien = norm(esperado) in norm(v) or (norm(v) and norm(v) in norm(esperado) and len(norm(v)) > 0.8 * len(norm(esperado)))
        if bien:
            ok.append(k)
        else:
            mal[k] = v
    r["json_valido"] = bool(datos)
    r["puntos"] = round(100 * len(ok) / len(CAMPOS))
    r["campos_mal"] = mal
    return r

# ---------------------------------------------------------------- pruebas: texto


def prueba_razonar(referencia, max_tokens):
    prompt = (
        "Este es el texto de una consulta catastral:\n\n" + referencia + "\n\n"
        "1) Suma las superficies de la tabla CONSTRUCCIÓN y di si coincide con la superficie construida.\n"
        "2) ¿Cuántos años tiene la construcción en 2026?\n"
        "3) ¿Qué porcentaje de la superficie gráfica de la parcela supone la superficie construida? (1 decimal)\n"
        "Explica brevemente y termina con UNA línea JSON exactamente así: "
        '{"suma": <número>, "coincide": <true|false>, "antiguedad": <número>, "porcentaje": <número>}')
    r = chat([{"role": "user", "content": prompt}], max_tokens=max_tokens)
    d = bloque_json(r.get("contenido", "")) or {}
    pts = 0
    try:
        pts += 25 if float(d.get("suma")) == 117 else 0
    except Exception:
        pass
    pts += 25 if d.get("coincide") is True or str(d.get("coincide")).lower() in ("true", "si", "sí") else 0
    try:
        pts += 25 if float(d.get("antiguedad")) == 22 else 0
    except Exception:
        pass
    try:
        pts += 25 if abs(float(str(d.get("porcentaje")).replace("%", "").replace(",", ".")) - 78.5) <= 0.2 else 0
    except Exception:
        pass
    r["json"] = d
    r["puntos"] = pts
    return r


TESTS_CODIGO = r'''
import json, sys
fallos = []
def check(nombre, cond):
    if not cond:
        fallos.append(nombre)
T1 = """Destino    Escalera/Planta/Puerta   Superficie m2
VIVIENDA 1/00/01 56
VIVIENDA 1/01/01 39
VIVIENDA 1/00/02 9
VIVIENDA 1/01/02 13
"""
T2 = """
Destino\tEscalera/Planta/Puerta\tSuperficie m2
  VIVIENDA        1/00/01     70
ELEMENTOS COMUNES   1/00/03   12
ALMACEN\t1/-1/01\t20
GARAJE   1/-1/02    15

"""
def probar(nombre, fn):
    try:
        if not fn():
            fallos.append(nombre)
    except Exception as e:
        fallos.append("%s: %r" % (nombre, e))
probar("t1_filas", lambda: len(parse_tabla(T1)) == 4)
probar("t1_primera", lambda: parse_tabla(T1)[0] == {"destino": "VIVIENDA", "escalera": "1", "planta": "00", "puerta": "01", "superficie": 56})
probar("t1_totales", lambda: total_por_planta(parse_tabla(T1)) == {"00": 65, "01": 52})
probar("t2_filas", lambda: len(parse_tabla(T2)) == 4)
probar("t2_multipalabra", lambda: any(f.get("destino") == "ELEMENTOS COMUNES" and f.get("superficie") == 12 for f in parse_tabla(T2)))
probar("t2_sotano", lambda: total_por_planta(parse_tabla(T2)) == {"00": 82, "-1": 35})
probar("vacio", lambda: parse_tabla("") == [] and total_por_planta([]) == {})
print(json.dumps({"fallos": fallos, "total": 7}))
'''


def prueba_codigo_una(max_tokens):
    prompt = (
        "Escribe en Python 3 dos funciones, sin dependencias externas:\n\n"
        "1. `parse_tabla(texto)` recibe el texto de una tabla de construcción del catastro como esta:\n\n"
        "Destino    Escalera/Planta/Puerta   Superficie m2\n"
        "VIVIENDA 1/00/01 56\nELEMENTOS COMUNES 1/00/03 12\nALMACEN 1/-1/01 20\n\n"
        "y devuelve una lista de diccionarios con las claves destino (str), escalera (str), planta (str), "
        "puerta (str) y superficie (int). Ignora la cabecera y las líneas vacías. El destino puede tener "
        "varias palabras y las columnas pueden estar separadas por espacios o tabuladores.\n"
        "2. `total_por_planta(filas)` devuelve un dict {planta: suma de superficies}.\n\n"
        "Devuelve solo el código en un bloque ```python.")
    r = chat([{"role": "user", "content": prompt}], max_tokens=max_tokens)
    bloques = re.findall(r"```(?:python|py)?\s*\n(.*?)```", r.get("contenido", ""), flags=re.S)
    codigo = next((b for b in reversed(bloques) if "def parse_tabla" in b), None)
    if codigo is None and "def parse_tabla" in r.get("contenido", ""):
        codigo = r["contenido"]
    r["codigo"] = codigo or ""
    if not codigo:
        r["puntos"] = 0
        r["tests"] = "sin código"
        return r
    with tempfile.TemporaryDirectory() as d:
        ruta = os.path.join(d, "prueba.py")
        with open(ruta, "w") as f:
            f.write(codigo + "\n\n" + TESTS_CODIGO)
        try:
            p = subprocess.run([sys.executable, "-I", ruta], cwd=d, capture_output=True,
                               text=True, timeout=20)
            res = json.loads(p.stdout.strip().splitlines()[-1])
            r["tests"] = res
            r["puntos"] = round(100 * (res["total"] - len(res["fallos"])) / res["total"])
        except Exception as e:
            r["tests"] = "error al ejecutar: %r" % (e,)
            r["puntos"] = 0
    return r


def media(valores):
    valores = [v for v in valores if v]
    return round(sum(valores) / len(valores), 1) if valores else None


def suma_draft(partes):
    n = sum(x.get("draft_n") or 0 for x in partes)
    ok = sum(x.get("draft_aceptados") or 0 for x in partes)
    return (n or None), (ok if n else None)


def prueba_codigo(max_tokens, runs):
    intentos = []
    for i in range(runs):
        if runs > 1:
            log("     intento %d/%d…" % (i + 1, runs))
        intentos.append(prueba_codigo_una(max_tokens))
    n, ok = suma_draft(intentos)
    return {
        "intentos": intentos,
        "puntos": round(sum(x.get("puntos") or 0 for x in intentos) / len(intentos)),
        "puntos_cada_uno": [x.get("puntos") for x in intentos],
        "cortados": sum(1 for x in intentos if x.get("fin") == "length"),
        "segundos": round(sum(x.get("segundos") or 0 for x in intentos), 1),
        "tok_s_generacion": media(x.get("tok_s_generacion") for x in intentos),
        "draft_n": n, "draft_aceptados": ok,
    }


def prueba_velocidad(referencia, max_tokens):
    """Code once + email: same work for every draft variant, to compare tok/s."""
    c = prueba_codigo_una(max_tokens)
    r = prueba_redactar(referencia, max_tokens)
    n, ok = suma_draft([c, r])
    return {
        "codigo": c, "redactar": r,
        "puntos": c.get("puntos"), "fin": c.get("fin"),
        "segundos": round((c.get("segundos") or 0) + (r.get("segundos") or 0), 1),
        "tok_s_generacion": media([c.get("tok_s_generacion"), r.get("tok_s_generacion")]),
        "tok_s_codigo": c.get("tok_s_generacion"), "tok_s_redactar": r.get("tok_s_generacion"),
        "draft_n": n, "draft_aceptados": ok,
    }


HERRAMIENTAS = [
    {"type": "function", "function": {
        "name": "buscar_catastro",
        "description": "Devuelve los datos catastrales de un inmueble a partir de su referencia catastral.",
        "parameters": {"type": "object", "properties": {
            "referencia": {"type": "string", "description": "Referencia catastral de 20 caracteres"}},
            "required": ["referencia"]}}},
    {"type": "function", "function": {
        "name": "calcular_cuota_hipoteca",
        "description": "Calcula la cuota mensual de una hipoteca a tipo fijo.",
        "parameters": {"type": "object", "properties": {
            "importe": {"type": "number", "description": "Importe del préstamo en euros"},
            "anios": {"type": "integer", "description": "Plazo en años"},
            "interes_anual": {"type": "number", "description": "Tipo de interés anual en porcentaje, p. ej. 3.5"}},
            "required": ["importe", "anios", "interes_anual"]}}},
]


def _args(tc):
    try:
        a = tc.get("function", {}).get("arguments")
        return json.loads(a) if isinstance(a, str) else (a or {})
    except Exception:
        return {}


def prueba_herramientas(max_tokens):
    casos = []
    r1 = chat([{"role": "user", "content": "¿Qué datos tiene el catastro del inmueble 5051914DR5755S0001DT?"}],
              max_tokens=max_tokens, tools=HERRAMIENTAS)
    ok1 = any(tc.get("function", {}).get("name") == "buscar_catastro"
              and str(_args(tc).get("referencia", "")).strip().upper() == "5051914DR5755S0001DT"
              for tc in r1.get("tool_calls", []))
    casos.append({"caso": "catastro", "ok": ok1, "tool_calls": r1.get("tool_calls"),
                  "contenido": r1.get("contenido", "")[:400], "error": r1.get("error")})
    r2 = chat([{"role": "user", "content": "¿Cuánto pagaría al mes por una hipoteca de 180.000 € a 30 años al 2,9 %?"}],
              max_tokens=max_tokens, tools=HERRAMIENTAS)
    ok2 = False
    for tc in r2.get("tool_calls", []):
        a = _args(tc)
        try:
            ok2 = ok2 or (tc.get("function", {}).get("name") == "calcular_cuota_hipoteca"
                          and float(a.get("importe")) == 180000 and int(float(a.get("anios"))) == 30
                          and abs(float(a.get("interes_anual")) - 2.9) < 1e-6)
        except Exception:
            pass
    casos.append({"caso": "hipoteca", "ok": ok2, "tool_calls": r2.get("tool_calls"),
                  "contenido": r2.get("contenido", "")[:400], "error": r2.get("error")})
    seg = (r1.get("segundos") or 0) + (r2.get("segundos") or 0)
    return {"casos": casos, "puntos": 50 * ok1 + 50 * ok2, "segundos": round(seg, 1),
            "tok_s_generacion": r2.get("tok_s_generacion") or r1.get("tok_s_generacion"),
            "error": r1.get("error") or r2.get("error")}


def prueba_redactar(referencia, max_tokens):
    prompt = ("Con estos datos catastrales:\n\n" + referencia + "\n\nEscribe un correo breve (máximo 120 palabras) "
              "en español a una notaría pidiendo cita para revisar la compra de este inmueble. Incluye la "
              "referencia catastral y la dirección. Solo el correo, con asunto.")
    r = chat([{"role": "user", "content": prompt}], max_tokens=max_tokens)
    t = r.get("contenido", "")
    palabras = len(re.findall(r"\w+", t))
    pts = 0
    pts += 40 if "5051914DR5755S0001DT" in t.upper() else 0
    pts += 30 if "gueldera" in norm(t) else 0
    pts += 30 if 30 <= palabras <= 160 else 0
    r["palabras"] = palabras
    r["puntos"] = pts
    return r

# ---------------------------------------------------------------- bucle principal


def esperar_servidor(proc, nombre, log_path, limite_min=90):
    t0 = time.time()
    ultimo = 0
    while time.time() - t0 < limite_min * 60:
        if servidor_listo():
            return round(time.time() - t0, 1)
        if proc.poll() is not None:
            return None
        if time.time() - ultimo > 30:
            ultimo = time.time()
            try:
                with open(log_path, "rb") as f:
                    f.seek(max(0, os.path.getsize(log_path) - 400))
                    cola = f.read().decode(errors="replace").replace("\r", "\n").strip().splitlines()
                linea = cola[-1][:110] if cola else ""
            except Exception:
                linea = ""
            log("   … esperando a %s (%ds)  %s" % (nombre, time.time() - t0, linea))
        time.sleep(2)
    return None


def hay_servidor():
    return subprocess.run(["pgrep", "-f", PATRON_SERVIDOR], capture_output=True).returncode == 0


def parar():
    """Para el modelo y espera a que el puerto quede libre (si no, el siguiente no arranca)."""
    ia("stop")
    for _ in range(20):
        if not hay_servidor() and not servidor_listo():
            return
        time.sleep(1)
    subprocess.run(["pkill", "-9", "-f", PATRON_SERVIDOR], capture_output=True)
    time.sleep(2)


def opcion(nombre, defecto, alias=None):
    for clave in (nombre, alias):
        if clave and clave in sys.argv:
            k = sys.argv.index(clave)
            try:
                return int(sys.argv[k + 1])
            except (IndexError, ValueError):
                sys.exit("✗ %s needs a number" % clave)
    return defecto


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print(open(__file__, encoding="utf-8").read().split("\nimport ")[0])
        return
    valores = {"--code-runs", "--max-tokens"}
    args = [a for k, a in enumerate(sys.argv[1:], 1)
            if not a.startswith("--") and sys.argv[k - 1] not in valores]
    solo_instalados = "--installed-only" in sys.argv or "--solo-instalados" in sys.argv
    rapido = "--fast" in sys.argv or "--rapido" in sys.argv
    max_tok = opcion("--max-tokens", 1500 if rapido else 8192)
    runs = max(1, opcion("--code-runs", 1))

    paginas = sorted(glob.glob(os.path.join(TEST_DIR, "*.png")))
    ref_path = os.path.join(TEST_DIR, "referencia.txt")
    if not paginas or not os.path.exists(ref_path):
        sys.exit("✗ Faltan las páginas de prueba en %s" % TEST_DIR)
    referencia = open(ref_path, encoding="utf-8").read()

    nombres = [m["nombre"] for m in MODELOS]
    desconocidos = [a for a in args if a not in nombres]
    if desconocidos:
        sys.exit("✗ No conozco: %s. Opciones: %s" % (", ".join(desconocidos), " ".join(nombres)))
    elegidos = [m for m in MODELOS if (m["nombre"] in args) if args] or \
               [m for m in MODELOS if not args and m.get("defecto")]

    salida = os.path.join(results_root(), datetime.datetime.now().strftime("%Y-%m-%d_%H%M"))
    os.makedirs(salida, exist_ok=True)
    resumen = {"fecha": datetime.datetime.now().isoformat(timespec="seconds"),
               "llama_cpp": version_llama(), "rapido": rapido, "max_tokens": max_tok,
               "repeticiones_codigo": runs, "modelos": {}}
    log("ia-bench · %d modelos · resultados en %s" % (len(elegidos), salida))
    log("llama.cpp: %s · max_tokens %d · código ×%d" % (resumen["llama_cpp"], max_tok, runs))
    log("⚠️  Se parará cualquier modelo que esté corriendo. Ctrl+C para cancelar.\n")

    def guardar():
        with open(os.path.join(salida, "resultados.json"), "w", encoding="utf-8") as f:
            json.dump(resumen, f, ensure_ascii=False, indent=2)
        escribir_resumen(resumen, os.path.join(salida, "resumen.md"))

    try:
        for m in elegidos:
            nombre, pruebas, env_extra = m["nombre"], m["pruebas"], m.get("env", {})
            ia_txt = " ".join(["%s=%s" % kv for kv in env_extra.items()] + ["ia"] + m["ia"])
            log("=== %s · %s (%s) ===" % (nombre, m["descripcion"], ia_txt))
            res = {"descripcion": m["descripcion"], "ia": ia_txt, "pruebas": {}}
            resumen["modelos"][nombre] = res
            ya = instalado(m["lista"])
            res["ya_instalado"] = ya
            if not ya:
                if solo_instalados:
                    log("   (no instalado, lo salto)\n")
                    res["estado"] = "saltado"
                    continue
                gb = TAMANOS.get(m["lista"], 7)
                libre = shutil.disk_usage(HOME).free / 1e9
                if libre < gb + 3:
                    log("   ✗ Solo quedan %.1f GB libres y hacen falta ~%.1f GB. Lo salto.\n" % (libre, gb))
                    res["estado"] = "sin espacio"
                    continue
                log("   ↓ hay que descargarlo (~%.1f GB)" % gb)

            parar()
            swap0 = swap_mb()
            log_path = os.path.join(salida, nombre + "-servidor.log")
            lf = open(log_path, "w")
            env = dict(os.environ, IA_YES="1", IA_PORT=str(PORT), **env_extra)
            proc = subprocess.Popen([IA] + m["ia"], stdout=lf, stderr=subprocess.STDOUT, env=env,
                                    start_new_session=True)
            listo = esperar_servidor(proc, nombre, log_path)
            if listo is None:
                log("   ✗ No arrancó (código %s). Mira %s\n" % (proc.returncode, log_path))
                res["estado"] = "no arrancó"
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except Exception:
                    pass
                parar()
                lf.close()
                guardar()
                continue
            res["segundos_arranque"] = listo
            log("   ✓ listo en %ss" % listo)

            pasos = []
            if "doc" in pruebas:
                pasos += [("transcribir", lambda: prueba_transcribir(nombre, paginas)),
                          ("extraer", lambda: prueba_extraer(nombre, paginas))]
            if "texto" in pruebas:
                pasos += [("razonar", lambda: prueba_razonar(referencia, max_tok)),
                          ("codigo", lambda: prueba_codigo(max_tok, runs)),
                          ("herramientas", lambda: prueba_herramientas(max_tok)),
                          ("redactar", lambda: prueba_redactar(referencia, max_tok))]
            if "velocidad" in pruebas:
                pasos += [("velocidad", lambda: prueba_velocidad(referencia, max_tok))]
            for clave, fn in pasos:
                log("   · %s…" % clave)
                res["pruebas"][clave] = fn()
                p = res["pruebas"][clave]
                extra = ""
                if p.get("draft_n"):
                    extra = " · aceptación %d%%" % round(100 * p["draft_aceptados"] / p["draft_n"])
                log("     %s puntos · %s s · %s tok/s%s" % (p.get("puntos"), p.get("segundos"),
                                                         p.get("tok_s_generacion"), extra))
                guardar()

            res["memoria_servidor_mb"] = rss_servidor_mb()
            s1 = swap_mb()
            res["swap_mb_antes"], res["swap_mb_despues"] = swap0, s1
            res["estado"] = "ok"
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except Exception:
                pass
            parar()
            lf.close()
            guardar()
            log("")
    except KeyboardInterrupt:
        log("\nCancelado. Guardo lo que hay.")
        parar()
    guardar()
    log("Hecho. Resumen: %s" % os.path.join(salida, "resumen.md"))


def vel_cod_correo(p):
    """tok/s of the code + email tests (what OpenCode-like work feels like)."""
    if "velocidad" in p:
        return p["velocidad"].get("tok_s_generacion")
    return media([p.get("codigo", {}).get("tok_s_generacion"), p.get("redactar", {}).get("tok_s_generacion")])


def escribir_resumen(resumen, ruta):
    modelos = resumen["modelos"]
    base_de = {m["nombre"]: m.get("base") for m in MODELOS}
    filas = []
    for nombre, r in modelos.items():
        p = r.get("pruebas", {})
        def pt(k):
            return str(p[k].get("puntos")) if k in p and p[k].get("puntos") is not None else "–"
        cod = "–"
        c = p.get("codigo") or (p.get("velocidad") or {}).get("codigo")
        if c and c.get("puntos") is not None:
            cod = str(c["puntos"])
            if len(c.get("puntos_cada_uno") or []) > 1:
                cod += " (%s)" % "/".join(str(x) for x in c["puntos_cada_uno"])
            if c.get("cortados") or c.get("fin") == "length":
                cod += " ✂"
        partes = [x for x in p.values() if isinstance(x, dict)]
        vel = media(x.get("tok_s_generacion") for x in partes)
        cc = vel_cod_correo(p)
        xbase = "–"
        b = base_de.get(nombre)
        if b and b in modelos and cc:
            cb = vel_cod_correo(modelos[b].get("pruebas", {}))
            if cb:
                xbase = "%.2f×" % (cc / cb)
        n = sum(x.get("draft_n") or 0 for x in partes)
        ok = sum(x.get("draft_aceptados") or 0 for x in partes)
        acept = ("%d%%" % round(100 * ok / n)) if n else "–"
        filas.append("| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |" % (
            nombre, r.get("estado", "…"), pt("transcribir"), pt("extraer"), pt("razonar"), cod,
            pt("herramientas"), pt("redactar"), vel or "–", cc or "–", xbase, acept,
            r.get("memoria_servidor_mb") or "–"))
    with open(ruta, "w", encoding="utf-8") as f:
        f.write("# ia-bench · %s\n\nllama.cpp: %s · max_tokens %s · código ×%s\n\n" % (
            resumen["fecha"], resumen["llama_cpp"], resumen.get("max_tokens"), resumen.get("repeticiones_codigo")))
        f.write("| modelo | estado | transcribir | extraer | razonar | código | herramientas | redactar "
                "| tok/s | tok/s cód+correo | ×base | aceptación | RAM MB |\n")
        f.write("|---|---|---|---|---|---|---|---|---|---|---|---|---|\n")
        f.write("\n".join(filas) + "\n\nPuntos sobre 100. ✂ = la respuesta se cortó por max_tokens (se quedó "
                "pensando). «×base» compara la velocidad con el mismo modelo sin borrador en esta misma "
                "ejecución; «aceptación» es el % de tokens del borrador que se aceptaron.\n"
                "Las respuestas completas están en resultados.json.\n")


if __name__ == "__main__":
    main()
